# Copy to mcp/.env (gitignored). With none of the OAuth lines the server speaks stdio only,
# which is what a local MCP client (Claude Code, Claude Desktop) wants.

# Optional: the ledger database. Default: the local socket, database `finance`.
# FINANCE_DSN=host=/var/run/postgresql dbname=finance

# To serve over HTTP (e.g. as a claude.ai connector), all four are required, and only the
# GitHub account ALLOWED_GH_ID may connect.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# BASE_URL=https://finance.example.com
# ALLOWED_GH_ID=                 # numeric GitHub user ID: gh api user --jq .id
# HOST=127.0.0.1
# PORT=8789
